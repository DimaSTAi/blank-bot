# Токен бота от @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Режим ЮKassa: true для тестового магазина, false для боевого
YOOKASSA_TEST_MODE=true

# Ключи ЮKassa (тестовые или боевые)
YOOKASSA_SHOP_ID=your_shop_id_here
YOOKASSA_SECRET_KEY=your_secret_key_here

# Валюта по умолчанию
DEFAULT_CURRENCY=RUB

# URL, куда вернёт пользователь после оплаты в ЮKassa
YOOKASSA_RETURN_URL=https://t.me/your_bot_name

# URL для webhook-уведомлений от ЮKassa (пока можно оставить пустым)
YOOKASSA_WEBHOOK_URL=

# Секрет для проверки webhook-уведомлений (пока можно оставить пустым)
YOOKASSA_WEBHOOK_SECRET=

# Прокси для доступа к Telegram API (оставьте пустым, если не нужен)
PROXY_URL=
